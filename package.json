{
  "name": "meetpoint",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.meetpoint",
    "productName": "meetpoint",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png"
    ],
    "win": {
      "icon": "./icon.ico",
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "dark": "^0.0.2-2",
    "reader": "^0.0.8"
  }
}
